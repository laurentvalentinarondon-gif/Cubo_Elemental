theme_override_font_sizes/font_size = 18
text = "🏛️ LABERINTO 3D"

[node name="Spacer" type="Control" parent="TopBar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="LivesLabel" type="Label" parent="TopBar"]
layout_mode = 2
